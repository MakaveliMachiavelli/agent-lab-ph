{
  "name": "@n8n/db",
  "version": "1.35.6",
  "main": "dist/index.js",
  "module": "src/index.ts",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "LICENSE_EE.md",
    "LICENSE.md"
  ],
  "dependencies": {
    "class-validator": "0.14.0",
    "flatted": "3.4.2",
    "lodash": "4.18.1",
    "nanoid": "3.3.8",
    "p-lazy": "3.1.0",
    "reflect-metadata": "0.2.2",
    "uuid": "11.1.1",
    "xss": "1.0.15",
    "zod": "3.25.76",
    "@n8n/api-types": "1.35.4",
    "@n8n/backend-common": "1.35.5",
    "@n8n/config": "2.33.4",
    "@n8n/constants": "0.34.0",
    "@n8n/di": "0.16.0",
    "@n8n/permissions": "0.72.0",
    "@n8n/decorators": "1.35.4",
    "@n8n/utils": "1.43.1",
    "@n8n/typeorm": "0.7.0",
    "n8n-workflow": "2.35.3",
    "n8n-core": "2.35.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/lodash": "4.17.17",
    "@testcontainers/postgresql": "^11.13.0",
    "@vitest/coverage-v8": "4.1.9",
    "express": "5.1.0",
    "testcontainers": "^11.13.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "^8.0.2",
    "vitest": "^4.1.9",
    "vitest-mock-extended": "^3.1.0",
    "@n8n/typescript-config": "1.9.0",
    "@n8n/vitest-config": "1.20.0"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://n8n.io",
  "author": {
    "name": "Jan Oberhauser",
    "email": "jan@n8n.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n8n-io/n8n.git"
  },
  "scripts": {
    "clean": "rimraf dist .turbo .tmp-schema-docs",
    "gen:migration-index": "node scripts/generate-migration-index.mjs",
    "dev": "pnpm watch",
    "typecheck": "pnpm gen:migration-index && tsc --noEmit",
    "build": "pnpm gen:migration-index && tsc -p tsconfig.build.json",
    "build:unchecked": "pnpm gen:migration-index && tsc -p tsconfig.build.json --noCheck",
    "format": "biome format --write .",
    "format:check": "biome ci .",
    "lint": "pnpm gen:migration-index && eslint . --quiet",
    "lint:fix": "pnpm gen:migration-index && eslint . --fix",
    "watch": "pnpm gen:migration-index && tsc -p tsconfig.build.json --watch",
    "test": "pnpm gen:migration-index && vitest run",
    "test:unit": "pnpm gen:migration-index && vitest run",
    "test:dev": "pnpm gen:migration-index && vitest --silent=false",
    "migration:new": "node scripts/new-migration.mjs",
    "schema:docs:sqlite": "node scripts/schema-docs.mjs doc --db=sqlite",
    "schema:docs:postgres": "node scripts/schema-docs.mjs doc --db=postgres",
    "schema:docs": "pnpm schema:docs:sqlite && pnpm schema:docs:postgres",
    "schema:check:sqlite": "node scripts/schema-docs.mjs diff --db=sqlite",
    "schema:check:postgres": "node scripts/schema-docs.mjs diff --db=postgres",
    "schema:check": "pnpm schema:check:sqlite && pnpm schema:check:postgres"
  }
}